{% extends "settings/base.html.j2" %}

{% block breadcrumbs %}
<li class="breadcrumb-item active" aria-current="page">Privacy Zones</li>
{% endblock %}

{% block settings_content %}
<h1 class="mb-3">Privacy Zones</h1>

<p>You might want to remove points that are close to your home, work or relatives. For this you can define
    arbitrary polygons as "privacy zones". Go to <a href="https://geojson.io/" target="_blank">GeoJSON.io</a> to have a
    nice interactive tool for creating overlays. Create a single polygon, rectangle or circle to define a privacy zone.
    Each zone must only consist of a single area.</p>

<p>For more information about how to use this feature see <a href="https://martin-ueding.github.io/geo-activity-playground/create-a-privacy-zone/" target="_blank">this page in the documentation</a></p>

<h2 class="mb-3">{{ _("Apply privacy zones") }}</h2>

<p>{{ _("By default, privacy zones only affect the generated share images. Opt in below to also apply them elsewhere, at the cost of gaps in the track wherever it enters a privacy zone.") }}</p>

<form method="POST">
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="apply_privacy_zones_to_tracks"
            name="apply_privacy_zones_to_tracks" {{ 'checked' if apply_privacy_zones_to_tracks else '' }} />
        <label class="form-check-label" for="apply_privacy_zones_to_tracks">{{ _("Apply privacy zones to activity tracks everywhere") }}</label>
    </div>
    <div class="form-check form-switch mb-3">
        <input class="form-check-input" type="checkbox" role="switch" id="apply_privacy_zones_to_heatmap"
            name="apply_privacy_zones_to_heatmap" {{ 'checked' if apply_privacy_zones_to_heatmap else '' }} />
        <label class="form-check-label" for="apply_privacy_zones_to_heatmap">{{ _("Apply privacy zones to the heatmap") }}</label>
    </div>

    <button type="submit" class="btn btn-primary">{{ _("Save") }}</button>
</form>

<h2 class="mb-3 mt-4">{{ _("Zones") }}</h2>

{{ map_script() }}

{% if zones %}
<div class="row row-cols-1 row-cols-lg-3 g-4 mb-3">
    {% for zone in zones %}
    <div class="col">
        <div class="card h-100">
            <div class="card-img-top" id="map-zone-{{ zone.id }}" style="height: 250px; width: 100%;"></div>
            <script type="module">
                add_map("map-zone-{{ zone.id }}", {{ zone_geojsons[zone.id] | safe }})
            </script>
            <div class="card-body">
                <h5 class="card-title">{{ zone.name }}</h5>
                <a class="btn btn-sm btn-primary" href="{{ url_for('.privacy_zones_edit', id=zone.id) }}">{{ _("Edit") }}</a>
                <form method="post" action="{{ url_for('.privacy_zones_delete', id=zone.id) }}" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-danger"
                        onclick="if(!confirm('{{ _('Are you sure you want to delete this privacy zone?') }}')){event.preventDefault()}">{{ _("Delete") }}</button>
                </form>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<p class="text-muted">{{ _("No privacy zones defined yet.") }}</p>
{% endif %}

<a class="btn btn-primary" href="{{ url_for('.privacy_zones_new') }}">{{ _("New Privacy Zone") }}</a>
{% endblock %}
